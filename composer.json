{
    "name": "bear/query-repository-graph",
    "description": "Prints the cache graph that BEAR.QueryRepository attributes declare, without running the application",
    "keywords": ["cache", "graph", "BEAR.Sunday", "development"],
    "license": "MIT",
    "authors": [
        {
            "name": "Akihito Koriyama",
            "email": "akihito.koriyama@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "bear/query-repository": "^1.18",
        "bear/resource": "^1.22.4"
    },
    "require-dev": {
        "justinrainbow/json-schema": "^5.3 || ^6.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "BEAR\\QueryRepositoryGraph\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BEAR\\QueryRepositoryGraph\\": "tests/",
            "FakeVendor\\HelloWorld\\": "tests/Fake/fake-app/src"
        }
    },
    "bin": ["bin/qr-graph"],
    "scripts": {
        "test": ["./vendor/bin/phpunit"]
    },
    "config": {
        "sort-packages": true
    }
}
