{
    "name": "bear/query-repository-graph",
    "description": "Static analysis of the cache graph that BEAR.QueryRepository attributes declare",
    "keywords": [
        "cache",
        "graph",
        "BEAR.Sunday",
        "development",
        "static analysis"
    ],
    "homepage": "https://github.com/bearsunday/BEAR.QueryRepositoryGraph",
    "license": "MIT",
    "authors": [
        {
            "name": "Akihito Koriyama",
            "email": "akihito.koriyama@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-tokenizer": "*",
        "composer-runtime-api": "^2.0",
        "bear/query-repository": "^1.20.2",
        "bear/resource": "^1.35"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.8",
        "justinrainbow/json-schema": "^5.3 || ^6.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "BEAR\\QueryRepositoryGraph\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BEAR\\QueryRepositoryGraph\\": "tests/",
            "FakeVendor\\HelloWorld\\": "tests/Fake/fake-app/src",
            "QrGraphDemo\\": "demo/src"
        }
    },
    "bin": [
        "bin/qr-graph"
    ],
    "scripts": {
        "post-install-cmd": "@composer bin all install --ansi --ignore-platform-req=php",
        "post-update-cmd": "@composer bin all update --ansi --ignore-platform-req=php",
        "test": "phpunit",
        "coverage": "php -dzend_extension=xdebug.so -dxdebug.mode=coverage phpunit --coverage-text --coverage-html=build/coverage",
        "phpdbg": "phpdbg -qrr phpunit --coverage-text --coverage-html ./build/coverage --coverage-clover=build/coverage.xml",
        "pcov": "php -dextension=pcov.so -d pcov.enabled=1 phpunit --coverage-text --coverage-html=build/coverage --coverage-clover=build/coverage.xml",
        "mutation": "infection --threads=max",
        "cs": "phpcs",
        "cs-fix": "phpcbf src tests",
        "phpstan": "phpstan analyse -c phpstan.neon",
        "psalm": "psalm --show-info=false",
        "phpmd": "phpmd src text ./phpmd.xml",
        "baseline": "phpstan analyse -c phpstan.neon --generate-baseline --allow-empty-baseline && psalm --set-baseline=psalm-baseline.xml",
        "crc": "composer-require-checker check ./composer.json",
        "clean": [
            "phpstan clear-result-cache",
            "psalm --clear-cache"
        ],
        "sa": [
            "@phpstan",
            "@psalm"
        ],
        "tests": [
            "@cs",
            "@sa",
            "@test"
        ],
        "build": [
            "@clean",
            "@cs",
            "@sa",
            "@coverage",
            "@crc"
        ]
    },
    "scripts-descriptions": {
        "test": "Run unit tests",
        "coverage": "Generate test coverage report",
        "phpdbg": "Generate test coverage report (phpdbg)",
        "pcov": "Generate test coverage report (pcov)",
        "mutation": "Run mutation testing",
        "cs": "Check the coding style",
        "cs-fix": "Fix the coding style",
        "phpmd": "Analyze PHP code for potential issues",
        "clean": "Remove temporary files",
        "psalm": "Analyze code for type safety using Psalm",
        "phpstan": "Analyze code for errors using PHPStan",
        "sa": "Run static analysis",
        "baseline": "Generate baseline for PHPStan and Psalm",
        "crc": "Run composer require checker",
        "tests": "Run tests and quality checks",
        "build": "Build project"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true
        }
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": true
        }
    }
}
