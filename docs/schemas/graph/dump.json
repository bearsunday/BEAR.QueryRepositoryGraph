{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://bearsunday.github.io/BEAR.QueryRepository/schemas/graph/dump.json",
    "title": "qr-graph dump line",
    "description": "One line of `qr-graph dump`: the first line is `meta`, every other line is one resource and the cache declarations it makes. Edges start at the resource that declares them, so a line carries no `from`.",
    "oneOf": [
        {"$ref": "#/$defs/meta"},
        {"$ref": "#/$defs/resource"}
    ],
    "$defs": {
        "meta": {
            "type": "object",
            "required": ["meta"],
            "properties": {
                "meta": {
                    "type": "object",
                    "required": ["version", "namespaces", "dir"],
                    "properties": {
                        "version": {"const": 7},
                        "namespaces": {
                            "description": "URI host => PHP namespace. `page://self/html/blog-posting` is `{namespaces.self}\\Resource\\Page\\Html\\BlogPosting`.",
                            "type": "object",
                            "additionalProperties": {"type": "string"}
                        },
                        "dir": {"description": "The directory that was scanned.", "type": "string"},
                "counts": {
                    "description": "What the scan found: resource nodes, declared edges, and files the autoloader did not resolve.",
                    "type": "object",
                    "required": ["nodes", "edges", "skipped"],
                    "properties": {
                        "nodes": {"type": "integer", "minimum": 0},
                        "edges": {"type": "integer", "minimum": 0},
                        "skipped": {"type": "integer", "minimum": 0}
                    },
                    "additionalProperties": false
                },
                "tool": {
                    "description": "The tool that produced the graph.",
                    "type": "object",
                    "required": ["name", "version"],
                    "properties": {
                        "name": {"const": "qr-graph"},
                        "version": {"type": "string"}
                    },
                    "additionalProperties": false
                },
                "autoload": {
                    "description": "The application autoloader relative to the working directory; null when Cli was called without one or it lies outside the working directory.",
                    "type": ["string", "null"]
                }
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        },
        "resource": {
            "type": "object",
            "required": ["uri", "source"],
            "properties": {
                "uri": {"$ref": "#/$defs/uri"},
                "source": {"$ref": "#/$defs/source"},
                "cacheable": {
                    "description": "#[Cacheable] as declared.",
                    "type": "object",
                    "required": ["expiry", "expirySecond", "expiryAt", "type"],
                    "properties": {
                        "expiry": {"type": "string"},
                        "expirySecond": {"type": "integer"},
                        "expiryAt": {"type": "string"},
                        "type": {"enum": ["value", "view"]}
                    },
                    "additionalProperties": false
                },
                "donutCache": {"description": "#[DonutCache] on the class.", "const": true},
                "cacheableResponse": {"description": "#[CacheableResponse] on the class.", "const": true},
                "httpCache": {"description": "The Cache-Control value #[HttpCache] or #[NoHttpCache] declares.", "type": "string"},
                "layout": {
                    "description": "The class attribute extending BEAR.Resource's AbstractResourceLayout. Its parts are embedded by onGet() as an #[Embed] is; a `rel` both the layout and an onGet() #[Embed] declare is an error (1).",
                    "type": "object",
                    "required": ["name", "class", "source", "embed"],
                    "properties": {
                        "name": {"description": "The attribute's short class name, as in `#[ContentPage]`.", "type": "string"},
                        "class": {"type": "string"},
                        "source": {"description": "Where the attribute class is declared.", "$ref": "#/$defs/source"},
                        "embed": {"description": "The layout's EMBED constant as declared, each URI resolved against this resource's.", "type": "array", "items": {"$ref": "#/$defs/embed"}}
                    },
                    "additionalProperties": false
                },
                "methods": {
                    "description": "Only methods that declare something the cache acts on, keyed by name, in declaration order.",
                    "type": "object",
                    "additionalProperties": {"$ref": "#/$defs/method"}
                }
            },
            "additionalProperties": false
        },
        "method": {
            "type": "object",
            "required": ["source"],
            "properties": {
                "source": {"$ref": "#/$defs/source"},
                "cacheableResponse": {"description": "#[CacheableResponse] on the method.", "const": true},
                "embed": {
                    "description": "#[Embed]: this resource depends on `uri`; invalidating `uri` invalidates this resource once the child's tags are on it.",
                    "type": "array",
                    "items": {"$ref": "#/$defs/embed"}
                },
                "dependsOn": {
                    "description": "#[DependsOn] on onGet(): the stored resource carries the exact tag of the URI the template expands to. A write that purges that same tag (same path as written, same query keys) invalidates this resource, and every page that took this resource's tags when it embedded it.",
                    "type": "array",
                    "items": {"$ref": "#/$defs/dependency"}
                },
                "refresh": {
                    "description": "Purged then re-generated after a successful write: #[Refresh], and the resource's own onGet where its GET is stored (`implicit`).",
                    "type": "array",
                    "items": {"$ref": "#/$defs/target"}
                },
                "purge": {
                    "description": "Purged after a successful write: #[Purge], the resource's own onGet where its GET is not stored (`implicit`), and each list a #[Link(rel: 'collection')] on its onGet() names (`collection`).",
                    "type": "array",
                    "items": {"$ref": "#/$defs/target"}
                }
            },
            "additionalProperties": false
        },
        "embed": {
            "type": "object",
            "required": ["rel", "uri"],
            "properties": {
                "rel": {"type": "string"},
                "uri": {"$ref": "#/$defs/uri"},
                "template": {"$ref": "#/$defs/template"}
            },
            "additionalProperties": false
        },
        "dependency": {
            "type": "object",
            "required": ["uri"],
            "properties": {
                "uri": {"$ref": "#/$defs/uri"},
                "template": {"$ref": "#/$defs/template"}
            },
            "additionalProperties": false
        },
        "target": {
            "type": "object",
            "required": ["uri"],
            "properties": {
                "uri": {"$ref": "#/$defs/uri"},
                "template": {"$ref": "#/$defs/template"},
                "implicit": {
                    "description": "No #[Refresh] or #[Purge] is written: the write invalidates its own resource. Under `refresh`, the attribute named here makes the write read it again; under `purge`, `onGet` is a resource whose GET is not stored.",
                    "enum": ["Cacheable", "CacheableResponse", "RefreshCache", "onGet"]
                },
                "collection": {"description": "Named by #[Link(rel: 'collection')] on the resource's onGet(), not on the write method.", "const": true}
            },
            "additionalProperties": false
        },
        "uri": {
            "description": "scheme://host/path without query: exact-matchable against every other `uri`.",
            "type": "string",
            "pattern": "^[a-z]+://[^?#]+$"
        },
        "template": {"description": "The URI as declared, when it differs from `uri`: a query or template part, or another spelling of the resource's URI (`galleryArticle` for `gallery-article`).", "type": "string"},
        "source": {"description": "file:line, relative to the working directory.", "type": "string", "pattern": ":[0-9]+$"}
    }
}
